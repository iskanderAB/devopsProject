# Development Database Configuration
DEV_DB_USERNAME=conduit
DEV_DB_PASSWORD=conduit
DEV_DB_NAME=conduit_dev
DEV_DB_HOSTNAME=localhost
DEV_DB_DIALECT=mysql
DEV_DB_LOGGING=false

# Test Database Configuration
TEST_DB_USERNAME=conduit
TEST_DB_PASSWORD=conduit
TEST_DB_NAME=conduit_test
TEST_DB_HOSTNAME=localhost
TEST_DB_DIALECT=mysql
TEST_DB_LOGGING=false

# Production Database Configuration
PROD_DB_USERNAME=your_prod_username
PROD_DB_PASSWORD=your_prod_password
PROD_DB_NAME=conduit_prod
PROD_DB_HOSTNAME=your_prod_hostname
PROD_DB_DIALECT=mysql
PROD_DB_LOGGING=false

# Application Configuration
NODE_ENV=development
PORT=3001
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d